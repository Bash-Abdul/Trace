NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trace:trace@localhost:5432/trace
LOG_LEVEL=debug
TEST_DATABASE_URL=postgresql://trace:trace@localhost:5432/trace_test
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OUTBOX_ENCRYPTION_KEY=

# Required only when running pnpm worker:email. Use a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Frontend pages must read #token and POST it to the matching auth endpoint.
EMAIL_VERIFICATION_URL=

EMAIL_PASSWORD_RESET_URL=
# Exact frontend origin, without trailing slash. Production requires HTTPS.
APP_ORIGIN=http://localhost:3000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=604800

# Project invitation lifetime (7 days).
INVITATION_TTL_SECONDS=604800
