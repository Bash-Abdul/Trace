{
  "name": "@trace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"migrations/**/*.ts\" --no-error-on-unmatched-pattern",
    "format": "prettier --write --no-error-on-unmatched-pattern --config ../../.prettierrc.json --ignore-path ../../.prettierignore \"src/**/*.ts\" \"migrations/**/*.ts\" \"*.json\" \"*.js\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern --config ../../.prettierrc.json --ignore-path ../../.prettierignore \"src/**/*.ts\" \"migrations/**/*.ts\" \"*.json\" \"*.js\"",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "pnpm db:migrate:test && vitest run integration --no-file-parallelism",
    "db:migration:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language ts --migration-filename-format timestamp",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --envPath .env",
    "db:migrate:test": "node-pg-migrate up --migrations-dir migrations --envPath .env --database-url-var TEST_DATABASE_URL",
    "db:rollback": "node-pg-migrate down --migrations-dir migrations --envPath .env"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
