  "components": {
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 32
          }
        }
      },
      "Email": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ActionToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Reset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 32
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "sessionId",
          "csrfToken"
        ],
        "properties": {
          "user": {
            "type": "object",
            "required": [
              "id",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "Sessions": {
        "type": "object",
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "last_used_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "idle_expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "absolute_expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "current": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateProject": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "approvalRoute",
          "creatorRole"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "approvalRoute": {
            "type": "string",
            "enum": [
              "IN_PLATFORM_PROPOSAL",
              "EXTERNALLY_APPROVED"
            ]
          },
          "creatorRole": {
            "type": "string",
            "enum": [
              "AUTHOR",
              "MAIN_REVIEWER"
            ]
          },
          "inviteEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "creatorRole": {
                  "const": "MAIN_REVIEWER"
                }
              }
            },
            "then": {
              "required": [
                "inviteEmail"
              ]
            }
          }
        ]
      },
      "InviteProjectMember": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "AUTHOR",
              "MAIN_REVIEWER",
              "DORMANT_REVIEWER"
            ]
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "title",
          "created_by_user_id",
          "author_user_id",
          "approval_route",
          "status",
          "version",
          "created_at",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "author_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "approval_route": {
            "type": "string",
            "enum": [
              "IN_PLATFORM_PROPOSAL",
              "EXTERNALLY_APPROVED"
            ]
          },
          "status": {
            "const": "SETUP"
          },
          "version": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "enum": [
              "AUTHOR",
              "MAIN_REVIEWER",
              "DORMANT_REVIEWER"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "AUTHOR",
                    "MAIN_REVIEWER",
                    "DORMANT_REVIEWER"
                  ]
                },
                "joined_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Invitation": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "AUTHOR",
              "MAIN_REVIEWER",
              "DORMANT_REVIEWER"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "accepted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cancelled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "accepted_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "description": "Returned only on issuance or reissue; never in lists."
          }
        }
      },
      "ProjectCreated": {
        "type": "object",
        "required": [
          "project",
          "invitation"
        ],
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "invitation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Invitation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InvitationAccepted": {
        "type": "object",
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ProjectEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "event": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectPage": {
        "type": "object",
        "required": [
          "projects",
          "nextCursor"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "InvitationPage": {
        "type": "object",
        "required": [
          "invitations",
          "nextCursor"
        ],
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ProjectHistory": {
        "type": "object",
        "required": [
          "events",
          "nextCursor"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectEvent"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "productionSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-trace-session"
      },
      "developmentSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "trace-session"
      }
    }
  }
}
